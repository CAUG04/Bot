# Copia este archivo a ".env" y rellena los valores.
# El ".env" real NUNCA debe subirse al repositorio (ver .gitignore).
#
# Nunca pongas aquí credenciales de Pocket Option: este bot no se conecta a
# tu cuenta, solo lee datos públicos de mercado y te envía la señal.

# Token del bot de Telegram (te lo da @BotFather). Déjalo vacío para
# desactivar las notificaciones por Telegram y usar solo la consola.
TELEGRAM_BOT_TOKEN=

# Chat ID de Telegram al que se envían las señales (el tuyo o el de un
# grupo/canal). Puedes obtenerlo con @userinfobot o revisando la respuesta
# de la API de Telegram tras escribirle al bot.
TELEGRAM_CHAT_ID=
